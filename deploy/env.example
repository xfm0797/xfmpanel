# =============================================================================
# XFMPanel 环境变量示例
#
# 生产环境由 systemd EnvironmentFile=/etc/xfmpanel/panel.env 注入；
# 本地开发直接 `cp deploy/env.example .env` 后自行 export，或使用 npm run dev。
# 所有变量都有合理默认值，按需覆盖即可。
# =============================================================================

# ---- 运行模式 ----
# prod | dev；dev 会启用 stub agent、放宽部分校验
XFMP_ENV=prod

# ---- 监听 ----
# 有 nginx 反代时保持回环；无域名直连公网时改为 0.0.0.0（install.sh 会自动判断）
XFMP_BIND=127.0.0.1
XFMP_PORT=8787
XFMP_PUBLIC_URL=https://panel.example.com
# 安装时探测到的地址（仅用于概览页展示，IPv6 不带方括号）
XFMP_PUBLIC_IPV4=
XFMP_PUBLIC_IPV6=

# ---- 数据与日志 ----
XFMP_DATA_DIR=/var/lib/xfmpanel
XFMP_DB=/var/lib/xfmpanel/xfmpanel.db
XFMP_LOG_DIR=/var/log/xfmpanel
XFMP_LOG_LEVEL=info

# ---- agent ----
# unix：连接特权 agent（唯一生产可用模式）；stub：进程内模拟（仅开发）
XFMP_AGENT_MODE=unix
XFMP_AGENT_SOCKET=/run/xfmpanel/agent.sock
XFMP_AGENT_SECRET_FILE=/etc/xfmpanel/agent.secret
XFMP_AGENT_TIMEOUT_MS=900000

# ---- 安全 ----
# auto：根据 X-Forwarded-Proto 判断是否给 Cookie 加 Secure；也可强制 1 / 0
XFMP_COOKIE_SECURE=auto
# 是否信任反向代理传来的 X-Forwarded-For / X-Forwarded-Proto
# 默认 0；只有面板确实位于可信反代之后时才设为 1（反代模式安装脚本会写入 1）
XFMP_TRUST_PROXY=0
XFMP_SESSION_TTL_HOURS=12
XFMP_LOGIN_MAX_ATTEMPTS=5
XFMP_LOGIN_LOCK_MINUTES=15
# 每 IP 每分钟请求上限
XFMP_RATE_LIMIT=240
# 仅首次启动生效；创建后请从配置中删除
XFMP_ADMIN_PASSWORD=

# ---- 任务 ----
# 1C512M 机型建议 1（install.sh 检测到 ≤1G 内存会自动写入 1）
XFMP_TASK_CONCURRENCY=2
# 1 表示低内存配置：PHP 默认进程数/内存上限收紧，适合 1C512M
XFMP_LOW_MEMORY=0
XFMP_TASK_POLL_MS=1000
XFMP_TASK_RETENTION_DAYS=30
XFMP_BACKUP_RETENTION_DAYS=30
XFMP_CERT_CHECK_RETENTION_DAYS=90
XFMP_AUDIT_RETENTION_DAYS=180

# ---- 证书巡检 ----
XFMP_CERT_CHECK_INTERVAL_MS=21600000
XFMP_CERT_RENEW_DAYS=30
XFMP_CERT_WARN_DAYS=15

# ---- 其它 ----
XFMP_TZ=Asia/Shanghai
